id: openclctsbinssru
plugin: resource
command:
    echo 'binname: integer_ops'
    echo 'command: /usr/local/checkbox-gfx/OpenCL-CTS/build/test_conformance/integer_ops/test_integer_ops quick*'

unit: template
template-resource: openclctsbinssru
template-filter: openclctsbinssru.binname != ''
template-engine: jinja2
template-unit: job
id: gfx_cl_sru_{{ binname }}
depends: gfx_cl_gpu_avail
category_id: opencl
flags: simple
user: root
_summary: Run the {{ binname }} tests from OpenCL-CTS
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
estimated_duration: 5m
command:
  {{ command }}

