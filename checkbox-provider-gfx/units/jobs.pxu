id: gfx_level_zero_test_affinity_helper
category_id: level-zero
flags: simple
user: root
_summary: Run the test_affinity_helper test from level zero tests
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
  NORMAL_USER
requires: cpuinfo.type == 'GenuineIntel'
estimated_duration: 1s
command:
  level-zero-tests.test test_affinity_helper
